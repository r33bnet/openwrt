. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
cudy,wr11000)
	ucidef_set_led_netdev "internet" "internet" "green:wan" "wan" "link"
	;;
ubnt,u7-pro-xgs)
	ucidef_set_led_wlan "wifi" "wifi" "blue:wlan" "phy0radio"
	;;
esac

board_config_flush

exit 0
