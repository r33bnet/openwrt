From: OpenWrt WR11000 port
Subject: [PATCH] spi: spi-qpic-snand: restore the 6.18.39 register sequence

Between 6.18.39 and 6.18.60 the stable tree picked up two changes to
this driver:

  930a7312c946 spi: spi-qpic-snand: avoid writing QPIC_EBI2_ECC_BUF_CFG
  8fd62901d6bf spi: spi-qpic-snand: write the feature value before
               executing SET_FEATURE

On the Cudy WR11000 (IPQ5332, GigaDevice GD5F1GM7REYIG) pages written by
a 6.18.60 kernel are partly unreadable: UBI hits ECC errors on its own
writes, and the vendor U-Boot reports "ecc failure" on the VID headers
and cannot read the kernel volume, so the board no longer boots from
NAND. Images written by 6.18.39 boot fine with the same U-Boot, and
these two commits are the only NAND-side difference.

Revert both for qualcommbe until it is known which one is responsible
and why; this is the driver as it ran on this hardware. Note that the
old SET_FEATURE path reads 4 bytes from the 1-byte feature buffer, which
the second commit also fixed.

---
--- a/drivers/spi/spi-qpic-snand.c
+++ b/drivers/spi/spi-qpic-snand.c
@@ -744,6 +744,8 @@
 
 	qcom_write_reg_dma(snandc, &snandc->regs->addr0, NAND_ADDR0, 2, 0);
 	qcom_write_reg_dma(snandc, &snandc->regs->cfg0, NAND_DEV0_CFG0, 3, 0);
+	qcom_write_reg_dma(snandc, &snandc->regs->ecc_buf_cfg, NAND_EBI2_ECC_BUF_CFG, 1, 0);
+
 	qcom_write_reg_dma(snandc, &snandc->regs->erased_cw_detect_cfg_clr,
 			   NAND_ERASED_CW_DETECT_CFG, 1, 0);
 	qcom_write_reg_dma(snandc, &snandc->regs->erased_cw_detect_cfg_set,
@@ -1014,6 +1016,8 @@
 {
 	qcom_write_reg_dma(snandc, &snandc->regs->addr0, NAND_ADDR0, 2, 0);
 	qcom_write_reg_dma(snandc, &snandc->regs->cfg0, NAND_DEV0_CFG0, 3, 0);
+	qcom_write_reg_dma(snandc, &snandc->regs->ecc_buf_cfg, NAND_EBI2_ECC_BUF_CFG,
+			   1, NAND_BAM_NEXT_SGL);
 }
 
 static void qcom_spi_config_cw_write(struct qcom_nand_controller *snandc)
@@ -1362,22 +1366,6 @@
 	snandc->regs->addr0 = cpu_to_le32(op->addr.val);
 	snandc->regs->addr1 = cpu_to_le32(0);
 
-	/*
-	 * The feature value has to reach NAND_FLASH_FEATURES before the
-	 * command is executed, otherwise the controller programs the chip
-	 * with whatever the register happened to hold from a previous
-	 * operation.
-	 */
-	if (opcode == SPINAND_SET_FEATURE) {
-		u32 ftr = 0;
-
-		memcpy(&ftr, op->data.buf.out,
-		       min_t(size_t, op->data.nbytes, sizeof(ftr)));
-		snandc->regs->flash_feature = cpu_to_le32(ftr);
-		qcom_write_reg_dma(snandc, &snandc->regs->flash_feature,
-				   NAND_FLASH_FEATURES, 1, NAND_BAM_NEXT_SGL);
-	}
-
 	qcom_write_reg_dma(snandc, &snandc->regs->cmd, NAND_FLASH_CMD, 3, NAND_BAM_NEXT_SGL);
 	qcom_write_reg_dma(snandc, &snandc->regs->exec, NAND_EXEC_CMD, 1, NAND_BAM_NEXT_SGL);
 
@@ -1415,8 +1403,10 @@
 		copy_ftr = true;
 		break;
 	case SPINAND_SET_FEATURE:
-		/* fully handled by qcom_spi_send_cmdaddr() */
-		return 0;
+		snandc->regs->flash_feature = cpu_to_le32(*(u32 *)op->data.buf.out);
+		qcom_write_reg_dma(snandc, &snandc->regs->flash_feature,
+				   NAND_FLASH_FEATURES, 1, NAND_BAM_NEXT_SGL);
+		break;
 	case SPINAND_PROGRAM_EXECUTE:
 	case SPINAND_WRITE_EN:
 	case SPINAND_RESET:
