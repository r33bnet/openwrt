# Minimal TFTP initramfs for the Cudy WR11000
#
# A RAM-boot rescue/install image only: wired LAN, SSH and a LuCI page to
# upload the full squashfs-sysupgrade.bin. DHCP on LAN. No Wi-Fi, no firewall,
# no TLS, no package manager. Build the real image from your normal
# config afterwards; nothing here is meant to be installed to NAND.
#
# Usage:
#   ./scripts/feeds update -a && ./scripts/feeds install -a
#   cp configs/cudy-wr11000-initramfs.config .config && make defconfig
#   make -j$(nproc)
# Output: bin/targets/qualcommbe/ipq53xx/
#   openwrt-qualcommbe-ipq53xx-cudy_wr11000-initramfs-uImage.itb
#
# On the device: LAN is 192.168.1.1 and hands out DHCP leases. U-Boot
# needs a static PC address for TFTP and uses the wan port; after boot
# move the cable to a LAN port and switch the PC to DHCP. Then
# http://192.168.1.1 -> System -> Backup / Flash Firmware, or
# scp + sysupgrade over SSH. The backup and
# restore scripts in docs/cudy-wr11000/backup-script still work (dropbear,
# mtd and ubi-utils are kept; their "wifi down" just prints an error).
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_cudy_wr11000=y

# --- images: initramfs only
CONFIG_TARGET_ROOTFS_INITRAMFS=y
# xz instead of the profile's zstd default: smallest cpio, still well under
# U-Boot's 64 MiB CONFIG_SYS_BOOTM_LEN once unpacked.
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
# CONFIG_TARGET_INITRAMFS_COMPRESSION_ZSTD is not set
# no squashfs/factory/sysupgrade from this config - use the full build
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# --- no Wi-Fi: drop DEVICE_PACKAGES and the target's wpad
# CONFIG_PACKAGE_kmod-ath12k is not set
# CONFIG_PACKAGE_ath12k-firmware-ipq5332 is not set
# CONFIG_PACKAGE_ath12k-firmware-qcn9274 is not set
# CONFIG_PACKAGE_ipq-wifi-cudy_wr11000 is not set
# CONFIG_PACKAGE_kmod-qrtr-smd is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set

# --- other target defaults not needed in RAM
# kmod-qcom-ppe stays: it is the Ethernet driver.
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-leds-gpio is not set
# CONFIG_PACKAGE_uboot-envtools is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_losetup is not set
# CONFIG_PACKAGE_procd-ujail is not set

# --- router stack: keep only dnsmasq (DHCP/DNS on LAN, IPv4 only)
CONFIG_PACKAGE_dnsmasq=y
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_nftables is not set
# CONFIG_PACKAGE_nftables-json is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-nft-core is not set
# CONFIG_PACKAGE_kmod-nft-fib is not set
# CONFIG_PACKAGE_kmod-nft-nat is not set
# CONFIG_PACKAGE_kmod-nf-conntrack is not set
# CONFIG_PACKAGE_kmod-nf-flow is not set
# CONFIG_PACKAGE_kmod-nf-nat is not set
# CONFIG_PACKAGE_kmod-nf-reject is not set
# CONFIG_PACKAGE_kmod-nf-reject6 is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_ppp-mod-pppoe is not set
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_kmod-pppoe is not set
# CONFIG_PACKAGE_kmod-pppox is not set

# --- no TLS and no package manager: LuCI is served over plain HTTP and
# firmware is uploaded from the PC. uclient-fetch stays (http:// works).
# uhttpd and uclient have PKG_BUILD_DEPENDS:=ustream-ssl (headers only; TLS
# is dlopen()ed at runtime). With no libustream-* selected the build falls
# back to the default mbedtls variant, which then fails in CMake because
# libmbedtls was never built. =m builds and stages both without putting
# them in the image.
CONFIG_PACKAGE_libustream-mbedtls=m
CONFIG_PACKAGE_libmbedtls=m
# CONFIG_PACKAGE_ca-bundle is not set
# CONFIG_PACKAGE_apk-mbedtls is not set

# --- LuCI, the minimum for System -> Flash Firmware
# Not the luci / luci-light collections: they pull luci-app-firewall,
# luci-proto-ppp and luci-proto-ipv6 back in. luci-mod-status is where the
# login lands; luci-mod-system has the flash page.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# CONFIG_PACKAGE_luci-mod-network is not set
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set
# CONFIG_PACKAGE_luci-proto-ppp is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_px5g-mbedtls is not set
# CONFIG_PACKAGE_luci-ssl is not set
